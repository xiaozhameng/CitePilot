# ---- 生成模型（DeepSeek，OpenAI 兼容协议）----
CITEPILOT_API_KEY=sk-xxx
CITEPILOT_API_BASE=https://api.deepseek.com/v1
CITEPILOT_MODEL=openai/deepseek-v4-flash

# ---- Embedding 提供方：bm25 | ollama | siliconflow ----
# bm25       = 纯词频召回，零依赖，任何环境都能跑（兜底降级用）
# ollama     = Docker 本地部署，docker run -d -p 11434:11434 ollama/ollama
# siliconflow= 云 API，免费额度，OpenAI 兼容
CITEPILOT_EMBED_PROVIDER=bm25
CITEPILOT_EMBED_MODEL=bge-m3
CITEPILOT_EMBED_BASE=http://127.0.0.1:11434/v1
CITEPILOT_EMBED_API_KEY=

# ---- Rerank 提供方：none | siliconflow ----
CITEPILOT_RERANK_PROVIDER=none
CITEPILOT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CITEPILOT_RERANK_BASE=https://api.siliconflow.cn/v1
CITEPILOT_RERANK_API_KEY=

# ---- 检索参数 ----
CITEPILOT_TOP_K=8
CITEPILOT_RRF_K=60
CITEPILOT_MAX_REWRITE=2

# ---- 路径 ----
CITEPILOT_CORPUS_DIR=corpus/payment-handbook
CITEPILOT_DB_PATH=var/citepilot.db

# ---- 计价（元 / 百万 token），按当期官方价格改 ----
CITEPILOT_PRICE_IN_PER_M=1.0
CITEPILOT_PRICE_OUT_PER_M=2.0

# ---- 服务层 ----
# 网关调内核时必须带上 X-Internal-Token: <这个值>
CITEPILOT_SERVE_HOST=127.0.0.1
CITEPILOT_SERVE_PORT=8077
CITEPILOT_INTERNAL_TOKEN=dev-local-token-change-me
